{
  "$meta": {
    "name": "OS 题库 · design tokens",
    "source": "untitled.pen variables",
    "version": "1.0.0",
    "rule": "禁止新增颜色。实现必须以本文件的 light/dark 值为唯一起点，禁止取色器二次取样。"
  },
  "color": {
    "bg":         { "light": "#FBFAF8", "dark": "#16181C", "use": "页面底色" },
    "card":       { "light": "#FFFFFF", "dark": "#1B1E23", "use": "题目卡、按钮底" },
    "surface":    { "light": "#F2F1EC", "dark": "#24272D", "use": "chip 默认底、图标钮底、选项 hover" },
    "surface2":   { "light": "#E8E7E1", "dark": "#2C3037", "use": "chip hover、开关关闭轨道" },
    "ink":        { "light": "#14161A", "dark": "#E9EBED", "use": "主文字、进度填充" },
    "ink2":       { "light": "#3C4148", "dark": "#BCC1C7", "use": "次要正文、未选选项" },
    "muted":      { "light": "#6E747C", "dark": "#8B9198", "use": "标签、说明文字" },
    "faint":      { "light": "#7E858D", "dark": "#858B93", "use": "序号、计数、页脚（仅非关键元信息）" },
    "border":     { "light": "#E1E1DA", "dark": "#2E333A", "use": "1px 描边、分隔线" },
    "borderSoft": { "light": "#EEEDE7", "dark": "#24282E", "use": "1px 极淡分隔线" },
    "solid":      { "light": "#14161A", "dark": "#D8DBDF", "use": "主按钮 / 选中态实心底" },
    "onSolid":    { "light": "#FFFFFF", "dark": "#14161A", "use": "实心底之上的文字与图标" },
    "ok":         { "light": "#0F6B46", "dark": "#6FD8A6", "use": "正确文字、正确徽标底" },
    "okTint":     { "light": "#EFF8F2", "dark": "#12241B", "use": "正确选项底、正确反馈条底" },
    "okBorder":   { "light": "#B9DFC9", "dark": "#26503A", "use": "正确浅底描边" },
    "onOk":       { "light": "#FFFFFF", "dark": "#0B1D15", "use": "正确徽标上的字" },
    "bad":        { "light": "#A3231A", "dark": "#F29287", "use": "错误文字、错误徽标底" },
    "badTint":    { "light": "#FDF3F1", "dark": "#2A1817", "use": "错误选项底、错误反馈条底" },
    "badBorder":  { "light": "#F0C7C0", "dark": "#522723", "use": "错误浅底描边" },
    "onBad":      { "light": "#FFFFFF", "dark": "#2A1310", "use": "错误徽标上的字" },
    "focus":      { "light": "#14161A", "dark": "#F1F2F4", "use": "键盘聚焦外描边（2px）" },
    "knobOff":    { "light": "#FFFFFF", "dark": "#C5C9CF", "use": "开关关闭滑块" },
    "knobOn":     { "light": "#FFFFFF", "dark": "#14161A", "use": "开关开启滑块" }
  },
  "font": {
    "display": "Inter Tight",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "serifReserved": "Source Serif 4"
  },
  "radius": {
    "chipMobile": 7, "chipDesktop": 8, "chipImmersive": 6,
    "optionMobile": 10, "optionDesktop": 11, "optionImmersive": 10,
    "cardMobile": 14, "cardDesktop": 16,
    "button": 9, "iconButton": 8, "toggle": 8, "badge": 6,
    "switchTrack": 10, "switchKnob": 8
  },
  "motion": {
    "out":    { "duration": 140, "easing": "cubic-bezier(.4,0,1,1)", "detail": "opacity 1→0, translateY 0→-6px" },
    "in":     { "duration": 200, "easing": "cubic-bezier(.16,1,.3,1)", "detail": "opacity 0→1, translateY 8px→0" },
    "progress": { "duration": 320, "easing": "linear", "detail": "宽度线性补间，可被打断" },
    "sidebar": { "duration": 220, "easing": "cubic-bezier(.16,1,.3,1)", "detail": "宽 272↔64，内容延迟 60ms 淡入" },
    "reduced": { "duration": 120, "detail": "仅透明度，位移归零，进度条直接跳变" }
  },
  "layout": {
    "desktop": { "viewport": 1440, "height": 900, "sidebarExpanded": 272, "sidebarCollapsed": 64, "questionColumn": 760, "contentPaddingX": 40, "topBar": 70, "progressRail": 3 },
    "document": { "viewport": 1440, "contentColumn": 880, "cardRadius": 16, "footer": 80 },
    "mobile": { "viewport": 375, "paddingX": 20, "headerPadY": 18, "optionMinHeight": 62 }
  }
}
